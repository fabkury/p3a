{
  "_about": [
    "Every setting a user can change, in one place. This file is the source of truth:",
    "the build generates the firmware's table and typed struct from it (tools/gen_settings.py),",
    "and the web UI loads it to draw and validate the settings page.",
    "",
    "Adding a setting is one entry here. Fields:",
    "  key       the name in the API and in storage. Lower case, source prefix first, unit suffix last (_s, _ms).",
    "  type      bool | int | string | enum | color",
    "  default   the value on a fresh device",
    "  min, max  for int. choices: for an int that may only take listed values.",
    "  max_len   for string: longest value, in characters.",
    "  values    for enum: the allowed strings. Stored by name, so the list may be reordered.",
    "  check     for string: a named extra validation (device_name, sd_root, country).",
    "  group     the settings page section.",
    "  label     the text shown beside the control.",
    "  reboot    true when a change takes effect at the next boot.",
    "  advanced  true hides it from the settings page; it stays changeable through the API.",
    "  secret    true for keys: never logged, and masked when settings are read back.",
    "",
    "Names: 2.0 renamed the 1.x keys to one convention (docs/2.0/DECISIONS.md, D27). The 1.x name is in 'was'."
  ],
  "settings": [
    {"key": "brightness", "type": "int", "default": 100, "min": 0, "max": 100, "group": "display", "label": "Brightness"},
    {"key": "rotation", "type": "int", "default": 0, "choices": [0, 90, 180, 270], "group": "display", "label": "Screen rotation"},
    {"key": "background_color", "type": "color", "default": "#000000", "group": "display", "label": "Background color"},
    {"key": "intro_animation", "type": "string", "default": "", "max_len": 31, "group": "display", "label": "Boot animation (empty picks one at random)", "was": "intro_anim_force"},
    {"key": "intro_duration_ms", "type": "int", "default": 3000, "min": 1000, "max": 7500, "group": "display", "label": "Boot animation duration", "was": "intro_anim_ms"},
    {"key": "show_fps", "type": "bool", "default": false, "group": "display", "label": "Show frame rate"},
    {"key": "indicator_enabled", "type": "bool", "default": true, "group": "display", "label": "Processing indicator", "advanced": true, "was": "proc_notif_enabled"},
    {"key": "indicator_size", "type": "int", "default": 64, "min": 16, "max": 256, "group": "display", "label": "Processing indicator size", "was": "proc_notif_size"},

    {"key": "dwell_s", "type": "int", "default": 30, "min": 0, "max": 86400, "group": "playback", "label": "Seconds per artwork (0 never advances)", "was": "dwell_time_ms"},
    {"key": "pick_mode", "type": "enum", "default": "random", "values": ["random", "recency"], "group": "playback", "label": "Order within a channel"},
    {"key": "channel_select", "type": "enum", "default": "stochastic", "values": ["swrr", "stochastic"], "group": "playback", "label": "How channels take turns", "was": "channel_select_mode"},
    {"key": "playback_max_speed", "type": "bool", "default": false, "group": "playback", "label": "Ignore frame delays", "was": "max_speed_playback"},

    {"key": "device_name", "type": "string", "default": "", "max_len": 16, "check": "device_name", "group": "network", "label": "Device name", "reboot": true},

    {"key": "sd_root", "type": "string", "default": "", "max_len": 56, "check": "sd_root", "group": "storage", "label": "Folder on the SD card (empty is /p3a)", "reboot": true, "was": "sdcard_root"},

    {"key": "makapix_refresh_s", "type": "int", "default": 14400, "min": 60, "max": 86400, "group": "makapix", "label": "Refresh interval", "was": "refresh_interval_sec"},
    {"key": "makapix_cache_size", "type": "int", "default": 2048, "min": 32, "max": 4096, "group": "makapix", "label": "Artworks kept per channel", "was": "channel_cache_size"},
    {"key": "makapix_view_ack", "type": "bool", "default": false, "group": "makapix", "label": "Ask the server to acknowledge views", "advanced": true, "was": "view_ack"},

    {"key": "giphy_api_key", "type": "string", "default": "", "max_len": 64, "group": "giphy", "label": "API key", "secret": true},
    {"key": "giphy_rating", "type": "enum", "default": "pg-13", "values": ["g", "pg", "pg-13", "r"], "group": "giphy", "label": "Content rating"},
    {"key": "giphy_country", "type": "string", "default": "", "max_len": 2, "check": "country", "group": "giphy", "label": "Country code", "was": "giphy_country_code"},
    {"key": "giphy_refresh_s", "type": "int", "default": 7200, "min": 60, "max": 28800, "group": "giphy", "label": "Refresh interval", "was": "giphy_refresh_interval"},
    {"key": "giphy_cache_size", "type": "int", "default": 350, "min": 32, "max": 500, "group": "giphy", "label": "GIFs kept per channel"},
    {"key": "giphy_rendition", "type": "string", "default": "fixed_height", "max_len": 31, "group": "giphy", "label": "Rendition", "advanced": true},
    {"key": "giphy_format", "type": "enum", "default": "gif", "values": ["gif", "webp"], "group": "giphy", "label": "Format", "advanced": true},
    {"key": "giphy_prefer_downsized", "type": "bool", "default": true, "group": "giphy", "label": "Prefer the downsized rendition", "advanced": true},

    {"key": "klipy_api_key", "type": "string", "default": "", "max_len": 96, "group": "klipy", "label": "API key", "secret": true},
    {"key": "klipy_rating", "type": "enum", "default": "pg-13", "values": ["g", "pg", "pg-13", "r"], "group": "klipy", "label": "Content rating"},
    {"key": "klipy_format", "type": "enum", "default": "gif", "values": ["gif", "webp"], "group": "klipy", "label": "Format"},
    {"key": "klipy_refresh_s", "type": "int", "default": 7200, "min": 60, "max": 28800, "group": "klipy", "label": "Refresh interval", "was": "klipy_refresh_interval"},
    {"key": "klipy_cache_size", "type": "int", "default": 350, "min": 32, "max": 2500, "group": "klipy", "label": "Artworks kept per channel"},

    {"key": "museum_refresh_s", "type": "int", "default": 345600, "min": 86400, "max": 691200, "group": "museum", "label": "Refresh interval", "was": "ai_refresh_sec"},
    {"key": "museum_cache_size", "type": "int", "default": 1024, "min": 32, "max": 4096, "group": "museum", "label": "Artworks kept per channel", "was": "ai_cache_size"},
    {"key": "harvard_api_key", "type": "string", "default": "", "max_len": 64, "group": "museum", "label": "Harvard Art Museums API key", "secret": true, "was": "ham_api_key"},
    {"key": "smithsonian_api_key", "type": "string", "default": "", "max_len": 64, "group": "museum", "label": "Smithsonian API key", "secret": true, "was": "si_api_key"}
  ]
}
