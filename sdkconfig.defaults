# p3a 2.0 build configuration: every deliberate departure from the ESP-IDF
# defaults, and nothing else. This file is the source of truth. `sdkconfig`
# is generated from it and is not tracked; delete it after editing this file.
#
# Seeded from the 1.x configuration (legacy/sdkconfig.defaults, produced by
# `idf.py save-defconfig`). Options that belong to a component 2.0 has not
# brought in yet are parked at the bottom, commented, under the milestone
# that enables them.

CONFIG_IDF_TARGET="esp32p4"

# The board's ESP32-P4 is silicon rev v1.0. From IDF 5.5.2 the default is
# rev 3.01 only and the bootloader rejects such images. Never remove.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Compiler
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
CONFIG_LIBC_OPTIMIZED_MISALIGNED_ACCESS=n
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Memory
CONFIG_SPIRAM=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# System
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n
CONFIG_FREERTOS_HZ=1000

# FAT
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_LABEL=y

# lwIP
CONFIG_LWIP_LOCAL_HOSTNAME="p3a"
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_TCP_MSL=30000
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_SNTP_UPDATE_DELAY=14400000
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# TLS and MQTT
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MQTT_PROTOCOL_311=n
CONFIG_MQTT_PROTOCOL_5=y
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y

# Board (Waveshare BSP): 720x720 panel, 24-bit, three framebuffers for the
# display pipeline's triple buffering. LVGL comes with the BSP and is unused.
CONFIG_BSP_LCD_TYPE_720_720_4_INCH=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB888=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_LV_BUILD_EXAMPLES=n

# Co-processor link (esp_hosted to the ESP32-C6 over SDIO). The transport is
# not restarted by esp_hosted on failure: p3a's own recovery decides.
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=40
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=40
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n

# --- Parked until their component arrives -----------------------------------
# M3.6 USB mass storage (esp_tinyusb):
# CONFIG_TINYUSB_MSC_ENABLED=y
# CONFIG_TINYUSB_CDC_ENABLED=y
# CONFIG_TINYUSB_VENDOR_COUNT=1
