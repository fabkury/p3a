# Overlay for the esp-idf #19034 evaluation (docs/jitter/espressif-patch/):
# build WITHOUT p3a's yielding sdmmc_wait_for_idle() wrapper so that the stock
# IDF function (or Espressif's patched one) is what runs. Never for release.
#   host/jitter-lab/build.ps1 -Diag -Extra sdkconfig.nowrap.defaults -Suffix nowrap
CONFIG_P3A_SD_IDLE_WAIT_WRAP=n
